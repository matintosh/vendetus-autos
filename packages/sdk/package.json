{
  "name": "@vendetus/sdk",
  "version": "0.2.0",
  "description": "Typed REST client for vendetus.autos.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": ["vendetus", "vendetus.autos", "sdk", "car", "marketplace", "uruguay"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matintosh/vendetus-autos.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://vendetus.autos/docs/sdk"
}
